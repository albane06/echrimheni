{
  "name": "@echrimheni/database",
  "version": "0.1.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./services/auth": {
      "types": "./dist/services/auth.d.ts",
      "import": "./dist/services/auth.js",
      "default": "./dist/services/auth.js"
    },
    "./services/seed-parser": {
      "types": "./dist/services/seed-parser.d.ts",
      "import": "./dist/services/seed-parser.js",
      "default": "./dist/services/seed-parser.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"Linting database...\""
  },
  "dependencies": {
    "@echrimheni/shared": "workspace:*",
    "@supabase/supabase-js": "^2.49.1",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/pdfkit": "^0.17.6",
    "typescript": "^5.8.2"
  }
}