# Supabase Configuration (P1: strict, aucun fallback mock-anon-key / mock-service-role-key)
# Sans ces variables, packages/database/src/client.ts throw SUPABASE_CONFIGURATION_REQUIRED.
# NE JAMAIS mettre de vraies clés ici : utilisez un fichier .env.local (non versionné).
NEXT_PUBLIC_SUPABASE_URL="https://votre-projet.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
# Alternative au format JWT historique : nouveau format publishable (une des deux suffit)
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SERVER ONLY — ne jamais préfixer par NEXT_PUBLIC_ / EXPO_PUBLIC_, ne jamais exposer au navigateur
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Database direct connection (for migrations & backend scripts)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
